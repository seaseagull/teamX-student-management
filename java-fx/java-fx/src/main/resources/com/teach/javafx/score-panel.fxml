<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1100.0" prefHeight="720.0"
            fx:controller="com.teach.javafx.controller.ScoreController"
            styleClass="page-root modern-page-dark"
            stylesheets="@css/page-modern.css">

    <top>
        <VBox spacing="14.0" styleClass="page-header">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <padding>
                        <Insets bottom="14" />
                    </padding>
                    <children>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <children>
                                <Label text="成绩管理" styleClass="page-title" />
                                <Label text="查询、查看成绩记录" styleClass="page-subtitle" />
                            </children>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="deleteButton" mnemonicParsing="false" text="删除记录" onAction="#onDeleteButtonClick" styleClass="danger-button" />
                                <Button fx:id="importButton" mnemonicParsing="false" text="批量导入" onAction="#onImportButtonClick" styleClass="secondary-button" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="filter-card">
                    <padding>
                        <Insets top="12" right="16" bottom="12" left="16" />
                    </padding>
                    <children>
                        <VBox spacing="2">
                            <children>
                                <Label text="按学号筛选" styleClass="form-label" />
                                <Label text="输入学号后点击查询即可刷新成绩列表" styleClass="page-subtitle" />
                            </children>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <TextField fx:id="numTextField" promptText="请输入学号" prefWidth="220.0" />
                        <Button mnemonicParsing="false" onAction="#onQueryButtonClick" text="查询" styleClass="primary-button" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.68" styleClass="dashboard-container">
            <items>
                <VBox styleClass="table-card" spacing="12">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="2">
                                    <children>
                                        <Label text="成绩列表" styleClass="detail-card-title" />
                                        <Label text="请点击查看详情" styleClass="page-subtitle" />
                                    </children>
                                </VBox>
                                <Pane HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <TableView fx:id="dataTableView" VBox.vgrow="ALWAYS" styleClass="content-card">
                            <columns>
                                <TableColumn fx:id="person_idColumn" prefWidth="120.0" text="学号" />
                                <TableColumn fx:id="semesterColumn" prefWidth="110.0" text="开课学期" />
                                <TableColumn fx:id="course_idColumn" prefWidth="85.0" text="课序号" />
                                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="课程名称" />
                                <TableColumn fx:id="markColumn" prefWidth="95.0" text="百分制成绩" />
                                <TableColumn fx:id="gpaColumn" prefWidth="75.0" text="绩点" />
                                <TableColumn fx:id="countColumn" prefWidth="75.0" text="学分" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox alignment="TOP_CENTER" spacing="18.0" styleClass="detail-card">
                    <padding>
                        <Insets top="24.0" right="22.0" bottom="24.0" left="22.0" />
                    </padding>
                    <children>
                        <Label text="成绩详情看板" styleClass="detail-card-title" maxWidth="Infinity" alignment="CENTER" />

                        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="content-scroll">
                            <content>
                                <GridPane hgap="12.0" vgap="14.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="90.0" minWidth="10.0" prefWidth="85.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="180.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="学号" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightStudentNumField" editable="false" disable="true" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                        <Label text="开课学期" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightSemesterField" editable="false" disable="true" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                        <Label text="课序号" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCourseNumField" editable="false" disable="true" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                        <Label text="课程名" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCourseNameField" editable="false" disable="true" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                                        <Label text="百分制成绩" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightMarkField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                                        <Label text="计算绩点" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightGpaField" editable="false" disable="true" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                                        <Label text="所占学分" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCreditField" editable="false" disable="true" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                                    </children>
                                </GridPane>
                            </content>
                        </ScrollPane>

                        <Button fx:id="saveButton" text="保存成绩修改" onAction="#onSaveButtonClick" maxWidth="Infinity" styleClass="primary-button" />
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>