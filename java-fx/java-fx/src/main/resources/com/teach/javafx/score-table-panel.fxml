<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.ScoreTableController" styleClass="page-root" stylesheets="@css/page-modern.css">
   <top>
       <VBox spacing="12.0">
           <children>
               <VBox spacing="2" alignment="CENTER_LEFT">
                   <children>
                       <Label text="成绩管理" styleClass="page-title" />
                       <Label text="添加、修改、查询、查看成绩记录" styleClass="page-subtitle" />
                   </children>
               </VBox>
               <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" styleClass="page-toolbar">
                   <children>
                       <FlowPane alignment="TOP_LEFT" prefHeight="40.0" prefWidth="300.0" BorderPane.alignment="CENTER">
                           <children>
                               <Button mnemonicParsing="false" onAction="#onAddButtonClick" text="添加">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Button>
                               <Button mnemonicParsing="false" onAction="#onEditButtonClick" text="修改">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Button>
                               <Button mnemonicParsing="false" onAction="#onDeleteButtonClick" text="删除">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Button>
                           </children>
                       </FlowPane>
                       <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
                       <FlowPane alignment="TOP_RIGHT"  prefHeight="40.0" prefWidth="500.0" BorderPane.alignment="CENTER">
                           <children>
                               <Label text="学生"  style="-fx-text-fill: #333">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Label>
                               <ComboBox fx:id="studentComboBox"  >
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </ComboBox>
                               <Label text="课程"  style="-fx-text-fill: #333">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Label>
                               <ComboBox fx:id="courseComboBox"  >
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </ComboBox>
                               <Button mnemonicParsing="false" onAction="#onQueryButtonClick" text="查询">
                                   <FlowPane.margin>
                                       <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                   </FlowPane.margin>
                               </Button>
                           </children>
                       </FlowPane>
                   </children>
               </HBox>
           </children>
           <padding>
               <Insets bottom="14.0" />
           </padding>
       </VBox>

   </top>
   <center>
       <VBox styleClass="table-card" VBox.vgrow="ALWAYS" spacing="12.0">
           <TableView fx:id="dataTableView"  >
               <columns>
                   <TableColumn fx:id="studentNumColumn" prefWidth="120.0" text="学号" />
                   <TableColumn fx:id="studentNameColumn" prefWidth="90.0" text="姓名" />
                   <TableColumn fx:id="classNameColumn" prefWidth="140.0" text="班级" />
                   <TableColumn fx:id="courseNumColumn" prefWidth="120.0" text="课程号" />
                   <TableColumn fx:id="courseNameColumn" prefWidth="140.0" text="课程名" />
                   <TableColumn fx:id="creditColumn" prefWidth="60.0" text="学分" />
                   <TableColumn fx:id="markColumn" prefWidth="60.0" text="成绩" />
                   <TableColumn fx:id="editColumn" prefWidth="60.0" text="操作" />
               </columns>
           </TableView>
       </VBox>

   </center>
</BorderPane>
