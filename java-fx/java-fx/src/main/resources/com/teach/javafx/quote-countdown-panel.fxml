<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.QuoteCountdownController"
      alignment="TOP_CENTER" spacing="20" prefWidth="950" prefHeight="620"
      style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #f1f5f9, #e2e8f0);">
    <padding>
        <Insets top="25" left="30" right="30" bottom="25"/>
    </padding>

    <VBox alignment="CENTER" spacing="5">
        <Label text="⏱️ 个人效率工作台" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label fx:id="currentDateLabel" text="今天是 2026年06月02日" style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="450">
            <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                <Label text="📅 期末倒计时" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                <HBox alignment="BASELINE_CENTER" spacing="8">
                    <Label text="距离本学期结束还有" style="-fx-font-size: 16px; -fx-text-fill: #334155;"/>
                    <Label fx:id="daysLeftLabel" text="--" style="-fx-font-size: 46px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    <Label text="天" style="-fx-font-size: 16px; -fx-text-fill: #334155;"/>
                </HBox>
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="学期已消耗进度" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Label fx:id="progressPercentLabel" text="0%" style="-fx-text-fill: #0284c7; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    </HBox>
                    <ProgressBar fx:id="semesterProgressBar" progress="0.0" maxWidth="Infinity" prefHeight="12"
                                 style="-fx-box-border: transparent; -fx-control-inner-background: #e2e8f0; -fx-accent: #0ea5e9; -fx-background-radius: 6;"/>
                </VBox>
            </VBox>

            <VBox spacing="15" VBox.vgrow="ALWAYS" alignment="CENTER"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                <HBox alignment="CENTER_LEFT">
                    <Label text="✨ 每日一言" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 换一句" onAction="#onRefreshQuoteClick"
                            style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-border-color: #a7f3d0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 4 10; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
                <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                    <Label fx:id="quoteTextLabel" text="正在静心聆听一言..." wrapText="true" alignment="CENTER" textAlignment="CENTER"
                           style="-fx-font-size: 16px; -fx-text-fill: #1e293b; -fx-font-style: italic; -fx-line-spacing: 4;"/>
                    <HBox alignment="CENTER_RIGHT" maxWidth="350">
                        <Label fx:id="quoteSourceLabel" text="—— Loading" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>

        <VBox spacing="15" HBox.hgrow="ALWAYS" prefWidth="450"
              style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
            <HBox alignment="CENTER_LEFT">
                <Label text="📝 生活事项待办" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="✅ 标记完成" onAction="#onDeleteTodoClick"
                        style="-fx-background-color: #f5f3ff; -fx-text-fill: #7c3aed; -fx-border-color: #ddd6fe; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 4 10; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="todoInputField" promptText="添加个新待办事项吧..." HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-padding: 6;"/>
                <DatePicker fx:id="todoDatePicker" promptText="到期日期" prefWidth="130"
                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 3;"/>
                <Button text="➕ 增加" onAction="#onAddTodoClick"
                        style="-fx-background-color: #7c3aed; -fx-text-fill: #ffffff; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <TableView fx:id="todoTableView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;">
                <columns>
                    <TableColumn fx:id="todoContentColumn" text="事项内容" prefWidth="240"/>
                    <TableColumn fx:id="todoTimeColumn" text="截止时间" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
