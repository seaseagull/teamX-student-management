<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.HomeworkEditDialogController"
      prefWidth="400" style="-fx-padding: 20;">

    <Label text="作业信息" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" prefWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="30.0" />
            <RowConstraints prefHeight="30.0" />
            <RowConstraints prefHeight="30.0" />
            <RowConstraints prefHeight="80.0" />
            <RowConstraints prefHeight="30.0" />
        </rowConstraints>

        <Label text="作业名称" GridPane.rowIndex="0" />
        <TextField fx:id="homeworkNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="课程" GridPane.rowIndex="1" />
        <ComboBox fx:id="courseComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="截止日期" GridPane.rowIndex="2" />
        <TextField fx:id="deadlineField" promptText="yyyy-MM-dd HH:mm:ss" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="备注" GridPane.rowIndex="3" />
        <TextArea fx:id="remarkField" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="完成状态" GridPane.rowIndex="4" />
        <ComboBox fx:id="stateNameComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <Separator />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="deleteButton" text="删除" visible="false" managed="false"
                style="-fx-background-color: #ff6b6b; -fx-text-fill: white;" />
        <Button text="取消" onAction="#onCancelClick" />
        <Button fx:id="saveButton" text="保存" onAction="#onSaveClick"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
    </HBox>
</VBox>