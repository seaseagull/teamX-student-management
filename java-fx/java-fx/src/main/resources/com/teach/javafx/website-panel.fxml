<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="800.0"
            styleClass="page-root"
            stylesheets="@css/page-modern.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.WebsiteController">

    <top>
        <HBox spacing="12.0" BorderPane.alignment="CENTER" styleClass="page-toolbar">
            <children>
                <VBox spacing="4.0">
                    <Label text="常用网站" styleClass="page-title" />
                    <Label text="快速定位至山东大学综合服务、学习相关、生活服务网站" styleClass="page-subtitle" />
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="addButton" text="添加网站" visible="false" managed="false"
                        styleClass="primary-button" onAction="#onAddButtonClick" />
            </children>
            <padding>
                <Insets bottom="10.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox fx:id="contentVBox" spacing="18.0" styleClass="table-card">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14" />
                </padding>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>