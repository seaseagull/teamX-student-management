<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.VolunteerActivityController"
            prefHeight="650.0" prefWidth="900.0"
            styleClass="page-root"
            stylesheets="@css/page-modern.css">
    <top>
        <VBox spacing="10.0" styleClass="page-toolbar">
            <HBox alignment="CENTER_LEFT">
                <Label text="志愿活动" styleClass="page-title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" text="添加活动" onAction="#onAddButtonClick" visible="false" managed="false" styleClass="primary-button" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.78">
            <VBox>
                <HBox fx:id="tabBox" spacing="0" styleClass="filter-card" >
                    <Label fx:id="allTab" text="全部" style="-fx-padding: 6 20; -fx-cursor: hand; -fx-background-radius: 6" />
                    <Label fx:id="pendingTab" text="待开始" style="-fx-padding: 6 20; -fx-cursor: hand; -fx-background-radius: 6" />
                    <Label fx:id="ongoingTab" text="进行中" style="-fx-padding: 6 20; -fx-cursor: hand; -fx-background-radius: 6" />
                    <Label fx:id="finishedTab" text="已结束" style="-fx-padding: 6 20; -fx-cursor: hand; -fx-background-radius: 6" />
                </HBox>
                <ScrollPane fitToWidth="true" styleClass="content-scroll">
                    <VBox fx:id="activityListBox" spacing="12.0" style="-fx-padding: 15;"/>
                </ScrollPane>
            </VBox>
            <VBox fx:id="studentActivityBox" visible="false" managed="false" spacing="10.0" styleClass="detail-card">
                <Label text="我的志愿活动" styleClass="page-title" />
                <Separator />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                    <VBox fx:id="studentActivityListBox" spacing="8.0" />
                </ScrollPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
