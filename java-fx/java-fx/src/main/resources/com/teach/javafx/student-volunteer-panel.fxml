<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.StudentVolunteerController"
            prefHeight="600.0" prefWidth="800.0"
            styleClass="page-root"
            stylesheets="@css/page-modern.css">

    <top>
        <VBox spacing="15.0" styleClass="page-toolbar">
            <Label text="我的志愿" styleClass="page-title" />
            <HBox spacing="20.0">
                <VBox spacing="5.0" prefWidth="220" styleClass="card">
                    <Label fx:id="totalHoursLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1677ff;" />
                    <Label text="总志愿时长(小时)"
                           styleClass="page-subtitle" />
                </VBox>
                <VBox spacing="5.0" prefWidth="220" styleClass="card">
                    <Label fx:id="activityCountLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #08BD91;" />
                    <Label text="已完成活动数"
                           styleClass="page-subtitle" />
                </VBox>
            </HBox>
            <Separator />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox fx:id="studentActivityListBox" spacing="12.0" style="-fx-padding: 0 20 20 20;" />
        </ScrollPane>
    </center>
</BorderPane>