<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane"
            prefWidth="1366.0"
            prefHeight="768.0"
            stylesheets="@../css/theme-light.css, @../css/component.css, @../css/layout.css"
            styleClass="root-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.MainFrameController">

    <top>
        <HBox fx:id="topBar" styleClass="top-bar" spacing="16" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20" />
            </padding>
            <children>
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <children>
                                <Label text="山东大学学生管理系统" styleClass="app-title" />
                                <Label fx:id="roleLabel" text="角色：-" styleClass="app-subtitle" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <TextField fx:id="searchField" promptText="搜索功能、菜单或页面" prefWidth="280" styleClass="search-box" />

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="themeToggleButton" text="深色模式" onAction="#onToggleTheme" styleClass="secondary-btn nav-btn" />
                        <Button fx:id="refreshButton" text="刷新" onAction="#onRefreshCurrentPage" styleClass="secondary-btn nav-btn" />
                        <Button fx:id="logoutButton" text="退出登录" onAction="#onLogoutAction" styleClass="danger-btn nav-btn" />
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="user-badge">
                            <children>
                                <Circle radius="14" styleClass="avatar-dot" />
                                <Label fx:id="userNameLabel" text="访客" styleClass="user-name" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <left>
        <ScrollPane fx:id="sidebarScrollPane" prefWidth="260.0" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="sidebar-scroll" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="sidebar" prefWidth="260.0" styleClass="sidebar" spacing="10">
                    <padding>
                        <Insets top="12" right="10" bottom="12" left="10" />
                    </padding>
                    <children>
                        <VBox fx:id="menuContainer" spacing="6" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <ScrollPane fx:id="contentScrollPane" fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="content-scroll" BorderPane.alignment="CENTER">
            <content>
                <StackPane fx:id="contentArea" styleClass="content-area">
                    <children>
                        <VBox fx:id="emptyStatePane" spacing="10" alignment="CENTER" styleClass="empty-state">
                            <children>
                                <Label text="欢迎使用山东大学学生管理系统" styleClass="empty-title" />
                                <Label text="请从左侧菜单选择功能页面" styleClass="empty-description" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" spacing="12" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="8" right="20" bottom="8" left="20" />
            </padding>
            <children>
                <Label fx:id="systemPrompt" text="正在初始化系统..." styleClass="status-text" HBox.hgrow="ALWAYS" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label fx:id="pagePrompt" text="首页" styleClass="status-text-muted" />
            </children>
        </HBox>
    </bottom>
</BorderPane>