<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.web.WebView?>
<BorderPane prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.SduMapController">
    <top>
        <FlowPane prefHeight="40.0" prefWidth="650.0" BorderPane.alignment="CENTER">
            <Label text="校区定位">
                <FlowPane.margin>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </FlowPane.margin>
            </Label>
            <Button text="中心校区" onAction="#onCampusCenterClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
            <Button text="洪家楼校区" onAction="#onCampusHongjialouClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
            <Button text="趵突泉校区" onAction="#onCampusBaotuquanClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
            <Button text="千佛山校区" onAction="#onCampusQianfoshanClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
            <Button text="软件园校区" onAction="#onCampusSoftwareClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
            <Button text="兴隆山校区" onAction="#onCampusXinglongshanClick">
                <FlowPane.margin><Insets bottom="5.0" left="2.0" right="2.0" top="5.0"/></FlowPane.margin>
            </Button>
        </FlowPane>
    </top>
    <center>
        <WebView fx:id="webView"></WebView>
    </center>
</BorderPane>
