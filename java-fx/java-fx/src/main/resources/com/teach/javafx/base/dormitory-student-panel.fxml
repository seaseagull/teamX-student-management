<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="500.0"
            fx:controller="com.teach.javafx.controller.base.DormitoryStudentController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <padding>
                <Insets bottom="3.0" left="3.0" right="3.0" top="3.0"/>
            </padding>
            <FlowPane prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                <Button mnemonicParsing="false" onAction="#onAssignButtonClick" text="分配学生">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </FlowPane.margin>
                </Button>
            </FlowPane>
        </HBox>
    </top>
    <center>
        <TableView fx:id="dataTableView">
            <columns>
                <TableColumn fx:id="studentIdColumn" prefWidth="100.0" text="学生ID" />
                <TableColumn fx:id="bedNoColumn" prefWidth="100.0" text="床位号" />
                <TableColumn fx:id="checkInDateColumn" prefWidth="150.0" text="入住日期" />
                <TableColumn fx:id="operateColumn" prefWidth="100.0" text="操作" />
            </columns>
        </TableView>
    </center>
</BorderPane>