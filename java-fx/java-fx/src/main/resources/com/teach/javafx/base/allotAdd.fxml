<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.AllotAddController"
      spacing="12"
      prefWidth="320">
    <padding>
        <Insets top="15" left="15" right="15" bottom="15"/>
    </padding>

    <TextField fx:id="tfStuName" promptText="学生姓名"/>
    <TextField fx:id="tfClassName" promptText="班级"/>
    <TextField fx:id="tfDormName" promptText="宿舍（例：1号楼101）"/>
    <TextField fx:id="tfBedNo" promptText="床位号"/>
    <ComboBox fx:id="cbState" promptText="状态">
        <items>
            <String fx:value="已入住"/>
            <String fx:value="待入住"/>
        </items>
    </ComboBox>

    <HBox spacing="10">
        <Button text="保存" onAction="#save"/>
        <Button text="取消" onAction="#cancel"/>
    </HBox>
</VBox>