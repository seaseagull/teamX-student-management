<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-root"
            stylesheets="@css/page-modern.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.NoticeController">
    <top>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="4.0">
                    <Label text="通知公告" styleClass="page-title" />
                    <Label text="查看系统公告，管理员可发布、编辑和删除通知" styleClass="page-subtitle" />
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="page-toolbar">
                    <children>
                        <Button fx:id="addButton" text="发布通知" onAction="#onAddClick" styleClass="primary-button" />
                        <Button fx:id="editButton" text="编辑" onAction="#onEditClick" disable="true" styleClass="secondary-button" />
                        <Button fx:id="deleteButton" text="删除" onAction="#onDeleteClick" disable="true" styleClass="danger-button" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="刷新" onAction="#onRefreshClick" styleClass="secondary-button" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="14" />
            </padding>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.4">
            <items>
                <VBox spacing="12.0" styleClass="table-card">
                    <children>
                        <Label text="通知列表" styleClass="page-subtitle" />
                        <ListView fx:id="noticeListView" prefHeight="460.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox spacing="12.0" styleClass="detail-card">
                    <children>
                        <Label text="通知详情" styleClass="page-subtitle" />
                        <TextField fx:id="titleField" promptText="请输入公告标题" />
                        <TextArea fx:id="contentArea" prefHeight="330.0" wrapText="true" promptText="请输入公告内容" VBox.vgrow="ALWAYS" />
                        <Label fx:id="timeLabel" styleClass="page-subtitle" />
                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="取消" onAction="#onCancelClick" styleClass="secondary-button" />
                                <Button fx:id="submitButton" text="发布/保存" onAction="#onSubmitClick" styleClass="success-button" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
