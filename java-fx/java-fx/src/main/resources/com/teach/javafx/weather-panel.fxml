<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.WeatherController"
      alignment="TOP_CENTER" spacing="25" prefWidth="750" prefHeight="600"
      style="-fx-background-color: linear-gradient(to bottom right, #1f4068, #162447, #0f1c3f); -fx-background-radius: 12;">
    <padding><Insets top="35" left="45" right="45" bottom="35"/></padding>

    <!-- 顶部搜索栏：扁平化圆角设计 -->
    <HBox spacing="12" alignment="CENTER">
        <TextField fx:id="cityField" promptText="🔍 输入城市（如：北京、济南）" prefWidth="280"
                   style="-fx-background-radius: 20; -fx-padding: 10 18; -fx-background-color: rgba(255, 255, 255, 0.9); -fx-font-size: 14px; -fx-text-fill: #111; -fx-prompt-text-fill: #888;"/>
        <Button text="查询天气" onAction="#onQueryButtonClick"
                style="-fx-background-color: #00d2ff; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,210,255,0.4), 10, 0, 0, 3);"/>
    </HBox>

    <!-- 错误状态/查询状态提示 -->
    <Label fx:id="errorLabel" style="-fx-text-fill: #ff7675; -fx-font-size: 14px; -fx-font-weight: bold;"/>

    <!-- 主天气看板：半透明毛玻璃卡片结构 -->
    <VBox spacing="30" alignment="CENTER" maxWidth="500"
          style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 30;">

        <!-- 头部：城市名与更新时间 -->
        <VBox spacing="8" alignment="CENTER">
            <Label fx:id="cityLabel" text="期待您的查询" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>
            <HBox alignment="CENTER" spacing="5">
                <Label text="数据更新时间:" style="-fx-text-fill: rgba(255, 255, 255, 0.5); -fx-font-size: 12px;"/>
                <Label fx:id="updateTimeLabel" text="--" style="-fx-text-fill: rgba(255, 255, 255, 0.5); -fx-font-size: 12px;"/>
            </HBox>
        </VBox>

        <!-- 核心区：超大温度显示与天气状况 -->
        <VBox spacing="12" alignment="CENTER">
            <Label fx:id="tempLabel" text="-- °C" style="-fx-font-size: 72px; -fx-font-weight: 300; -fx-text-fill: white;"/>
            <Label fx:id="textLabel" text="---" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00d2ff; -fx-padding: 5 15; -fx-background-color: rgba(0, 210, 255, 0.1); -fx-background-radius: 12;"/>
        </VBox>

        <!-- 分割线 -->
        <Separator style="-fx-opacity: 0.1; -fx-padding: 0 10;"/>

        <!-- 底部：4宫格各项天气细项指标 -->
        <GridPane hgap="40" vgap="20" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                <ColumnConstraints halignment="LEFT" minWidth="100"/>
                <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                <ColumnConstraints halignment="LEFT" minWidth="100"/>
            </columnConstraints>

            <!-- 第一行：体感温度 & 空气湿度 -->
            <Label text="体感温度" style="-fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="feelsLikeLabel" text="--" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="湿度" style="-fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label fx:id="humidityLabel" text="--" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <!-- 第二行：风向风力 & 风速 -->
            <Label text="风向" style="-fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-size: 14px;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="windDirLabel" text="--" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="风速" style="-fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-size: 14px;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label fx:id="windSpeedLabel" text="--" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        </GridPane>
    </VBox>
</VBox>