<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.LeaveRequestController">
    <center>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL">
            <items>
                <!-- 申请表单区域 -->
                <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f5f7fa;">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>

                    <Label text="📝 离校申请" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                    <GridPane hgap="15.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" prefWidth="250.0" />
                            <ColumnConstraints hgrow="SOMETIMES" prefWidth="250.0" />
                        </columnConstraints>

                        <Label text="开始时间：" />
                        <DatePicker fx:id="startDatePicker" prefWidth="150.0" GridPane.columnIndex="1" />
                        <ComboBox fx:id="startHourCombo" prefWidth="80.0" GridPane.columnIndex="2" />
                        <Label text=":" GridPane.columnIndex="2" />
                        <ComboBox fx:id="startMinuteCombo" prefWidth="80.0" GridPane.columnIndex="2" />

                        <Label text="结束时间：" GridPane.rowIndex="1" />
                        <DatePicker fx:id="endDatePicker" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <ComboBox fx:id="endHourCombo" prefWidth="80.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <ComboBox fx:id="endMinuteCombo" prefWidth="80.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                        <Label text="请假原因：" GridPane.rowIndex="2" />
                        <TextArea fx:id="reasonArea" prefHeight="80.0" prefWidth="400.0" wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />

                        <Label text="审批意见：" GridPane.rowIndex="3" />
                        <TextArea fx:id="commentArea" prefHeight="60.0" prefWidth="400.0" wrapText="true" editable="false" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                    </GridPane>

                    <HBox alignment="CENTER" spacing="20.0">
                        <Button fx:id="submitButton" text="提交申请" onAction="#onSubmitClick" style="-fx-background-color: #409eff; -fx-text-fill: white;" />
                        <Button text="重置" onAction="#onResetClick" />
                        <Button fx:id="approveButton" text="通过" onAction="#onApproveClick" visible="false" style="-fx-background-color: #67c23a; -fx-text-fill: white;" />
                        <Button fx:id="rejectButton" text="拒绝" onAction="#onRejectClick" visible="false" style="-fx-background-color: #f56c6c; -fx-text-fill: white;" />
                    </HBox>
                </VBox>

                <!-- 申请列表区域 -->
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="📋 我的申请记录" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Label fx:id="roleLabel" style="-fx-text-fill: #909399;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="statusFilterCombo" promptText="状态筛选" onAction="#onFilterChange" />
                        <Button text="刷新" onAction="#onRefreshClick" />
                    </HBox>

                    <TableView fx:id="dataTableView" prefHeight="300.0">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="studentNumColumn" prefWidth="120.0" text="学号" />
                            <TableColumn fx:id="studentNameColumn" prefWidth="100.0" text="姓名" />
                            <TableColumn fx:id="startTimeColumn" prefWidth="150.0" text="开始时间" />
                            <TableColumn fx:id="endTimeColumn" prefWidth="150.0" text="结束时间" />
                            <TableColumn fx:id="reasonColumn" prefWidth="200.0" text="请假原因" />
                            <TableColumn fx:id="statusColumn" prefWidth="80.0" text="状态" />
                            <TableColumn fx:id="adminCommentColumn" prefWidth="150.0" text="审批意见" />
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>