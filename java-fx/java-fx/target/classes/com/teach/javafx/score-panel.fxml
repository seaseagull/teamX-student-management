<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="950.0" prefHeight="650.0"
            fx:controller="com.teach.javafx.controller.ScoreController"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: white; -fx-padding: 12 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 2); -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="deleteButton" mnemonicParsing="false" text="🗑 物理删除" onAction="#onDeleteButtonClick"
                                style="-fx-background-color: #ff7675; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="importButton" mnemonicParsing="false" text="📥 批量导入" onAction="#onImportButtonClick"
                                style="-fx-background-color: #10ac84; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </children>
                </HBox>

                <Pane HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label text="当前查询学号:" style="-fx-text-fill: #495057; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        <TextField fx:id="numTextField" promptText="请输入学号..." prefWidth="150.0"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #ced4da; -fx-padding: 7 12; -fx-font-size: 13px;"/>
                        <Button mnemonicParsing="false" onAction="#onQueryButtonClick" text="🔍 检索成绩列表"
                                style="-fx-background-color: #2e86de; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 18; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(46,134,222,0.2), 5, 0, 0, 2);"/>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.68" style="-fx-background-color: transparent; -fx-padding: 15; -fx-box-border: transparent;">
            <items>
                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e9ecef; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 8, 0, 0, 4);">
                    <children>
                        <TableView fx:id="dataTableView" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-base: white; -fx-control-inner-background: white; -fx-table-cell-border-color: #f1f3f5;">
                            <columns>
                                <TableColumn fx:id="person_idColumn" prefWidth="120.0" text="学号" />
                                <TableColumn fx:id="semesterColumn" prefWidth="110.0" text="开课学期" />
                                <TableColumn fx:id="course_idColumn" prefWidth="85.0" text="课序号" />
                                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="课程名称" />
                                <TableColumn fx:id="markColumn" prefWidth="95.0" text="百分制成绩" />
                                <TableColumn fx:id="gpaColumn" prefWidth="75.0" text="绩点" />
                                <TableColumn fx:id="countColumn" prefWidth="75.0" text="学分" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox alignment="TOP_CENTER" spacing="20.0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e9ecef; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                    <padding>
                        <Insets bottom="25.0" left="22.0" right="22.0" top="25.0" />
                    </padding>
                    <children>
                        <Label text="📋 成绩详情看板" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #343a40; -fx-padding: 0 0 10 0; -fx-border-color: #f1f3f5; -fx-border-width: 0 0 1 0;" maxWidth="Infinity" alignment="CENTER"/>

                        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                                    style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-viewport-background-color: transparent;">
                            <content>
                                <GridPane hgap="12.0" vgap="14.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="90.0" minWidth="10.0" prefWidth="85.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="学号" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightStudentNumField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                        <Label text="开课学期" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightSemesterField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                        <Label text="课序号" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCourseNumField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                        <Label text="课程名" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCourseNameField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                                        <Label text="百分制成绩" style="-fx-text-fill: #2e86de; -fx-font-size: 13px; -fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightMarkField" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #2e86de; -fx-border-width: 1; -fx-padding: 6 10; -fx-font-weight: bold; -fx-text-fill: #2e86de;" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                                        <Label text="计算绩点" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightGpaField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                                        <Label text="所占学分" style="-fx-text-fill: #6c757d; -fx-font-size: 13px;" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                                        <TextField fx:id="rightCreditField" editable="false" disable="true" style="-fx-background-color: #e9ecef; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #495057;" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                                    </children>
                                </GridPane>
                            </content>
                        </ScrollPane>

                        <VBox alignment="CENTER" style="-fx-padding: 10 0 0 0;" maxWidth="Infinity">
                            <Button fx:id="saveButton" text="💾 保存成绩修改" onAction="#onSaveButtonClick" maxWidth="Infinity"
                                    style="-fx-background-color: #2e86de; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 0; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(46,134,222,0.3), 8, 0, 0, 3);"/>
                        </VBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>