<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.StudentCourseSelectController">
    <top>
        <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0">
            <padding>
                <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
            </padding>
            <FlowPane alignment="TOP_RIGHT" prefHeight="40.0" prefWidth="757.0" BorderPane.alignment="CENTER">
                <Label fx:id="teacherFilterLabel" alignment="CENTER_RIGHT" prefWidth="49.0" text="教师">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </Label>
                <ComboBox fx:id="teacherFilterComboBox" prefWidth="100.0">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </ComboBox>
                <Label fx:id="creditFilterLabel" alignment="TOP_RIGHT" prefWidth="49.0" text="学分">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </Label>
                <ComboBox fx:id="creditFilterComboBox" prefWidth="100.0">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </ComboBox>
                <Label fx:id="stateFilterLabel" alignment="CENTER_RIGHT" prefWidth="49.0" text="选课状态">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </Label>
                <ComboBox fx:id="stateFilterComboBox" prefWidth="100.0">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </ComboBox>
                <Label fx:id="searchLabel" alignment="CENTER_RIGHT" prefWidth="49.0" text="关键字">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </Label>
                <TextField fx:id="searchTextField" prefWidth="100.0">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </TextField>
                <Button mnemonicParsing="false" onAction="#onQueryButtonClick" text="查询">
                    <FlowPane.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </FlowPane.margin>
                </Button>
            </FlowPane>
            <Pane HBox.hgrow="ALWAYS" />

        </HBox>
    </top>
    <center>
        <SplitPane prefWidth="911.0">
            <items>
                <TableView fx:id="dataTableView">
                    <columns>
                        <TableColumn fx:id="numColumn" prefWidth="200.0" text="课程号" />
                        <TableColumn fx:id="nameColumn" prefWidth="200.0" text="课程名" />
                        <TableColumn fx:id="teacherNameColumn" prefWidth="200.0" text="教师" />
                        <TableColumn fx:id="creditColumn" prefWidth="150.0" text="学分" />
                        <TableColumn fx:id="preCourseColumn" prefWidth="350.0" text="前序课" />
                        <TableColumn fx:id="operateColumn" prefWidth="100.0" text="操作" />
                    </columns>
                </TableView>

            </items>
        </SplitPane>
    </center>
</BorderPane>
