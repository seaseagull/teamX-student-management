<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.VolunteerActivityDetailController"
            prefHeight="650.0" prefWidth="800.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15 20;">
            <Button text="← 返回" onAction="#onBackClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #1677FF; -fx-font-size: 14px; -fx-cursor: hand;" />
            <Label fx:id="titleLabel" text="活动详情" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS" />
            <!-- 管理员按钮 -->
            <Button fx:id="startSignupButton" text="开始报名" onAction="#onStartSignupClick" visible="false" managed="false"
                    style="-fx-background-color: #1677FF; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 6 16; -fx-background-radius: 4; -fx-cursor: hand;" />
            <Button fx:id="stopSignupButton" text="截止报名" onAction="#onStopSignupClick" visible="false" managed="false"
                    style="-fx-background-color: #FF4D4F; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 6 16; -fx-background-radius: 4; -fx-cursor: hand;" />
            <Button fx:id="finishButton" text="确认结束" onAction="#onFinishClick" visible="false" managed="false"
                    style="-fx-background-color: #08BD91; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 6 16; -fx-background-radius: 4; -fx-cursor: hand;" />
            <!-- 学生按钮 -->
            <Button fx:id="signupButton" text="我要报名" onAction="#onSignUpClick" visible="false" managed="false"
                    style="-fx-background-color: #1677FF; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 6 16; -fx-background-radius: 4; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="15.0" style="-fx-padding: 0 20 20 20;">

                <!-- 基本信息卡片 -->
                <VBox fx:id="infoCard" spacing="10.0"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #F0F0F0; -fx-border-radius: 8;">
                    <HBox spacing="10.0">
                        <Label fx:id="statusTag" style="-fx-padding: 3 10; -fx-background-radius: 4; -fx-font-size: 12px;" />
                    </HBox>
                    <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" wrapText="true" />
                    <Separator />
                    <Label fx:id="timeLabel" style="-fx-font-size: 14px; -fx-text-fill: #555;" />
                    <Label fx:id="locationLabel" style="-fx-font-size: 14px; -fx-text-fill: #555;" />
                    <Label fx:id="hoursLabel" style="-fx-font-size: 14px; -fx-text-fill: #555;" />
                    <Label fx:id="recruitLabel" style="-fx-font-size: 14px; -fx-text-fill: #1677FF; -fx-font-weight: bold;" />
                    <Separator />
                    <Label text="志愿工作" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <Label fx:id="workLabel" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #555; -fx-line-spacing: 4px;" />
                </VBox>

                <!-- 活动要求 -->
                <VBox fx:id="requireCard" spacing="8.0"
                      style="-fx-background-color: #FFFBE6; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="📋 活动要求" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #AD8B00;" />
                    <Label fx:id="requirementsLabel" wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-line-spacing: 3px;" />
                </VBox>

                <!-- 注意事项 -->
                <VBox fx:id="notesCard" spacing="8.0"
                      style="-fx-background-color: #F0F5FF; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="⚠ 注意事项" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1677FF;" />
                    <Label fx:id="notesLabel" wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-line-spacing: 3px;" />
                </VBox>

                <!-- 报名时间 -->
                <VBox spacing="5.0" style="-fx-padding: 10 0;">
                    <Label fx:id="signupTimeLabel" style="-fx-font-size: 12px; -fx-text-fill: #999;" />
                </VBox>

                <!-- 志愿者列表（管理员可见） -->
                <VBox fx:id="volunteerCard" visible="false" managed="false" spacing="10.0"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #F0F0F0; -fx-border-radius: 8;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="已报名志愿者" style="-fx-font-weight: bold; -fx-font-size: 15px;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Label fx:id="volunteerCountLabel" style="-fx-font-size: 13px; -fx-text-fill: #1677FF;" />
                    </HBox>
                    <Separator />
                    <TableView fx:id="volunteerTable" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="volNameColumn" prefWidth="100" text="姓名" />
                            <TableColumn fx:id="volNumColumn" prefWidth="120" text="学号" />
                            <TableColumn fx:id="volGenderColumn" prefWidth="60" text="性别" />
                            <TableColumn fx:id="volPhoneColumn" prefWidth="140" text="电话" />
                            <TableColumn fx:id="volOperateColumn" prefWidth="80" text="操作" />
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>