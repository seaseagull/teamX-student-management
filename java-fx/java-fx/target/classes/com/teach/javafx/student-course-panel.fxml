<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.StudentCourseController">

    <top>
        <VBox spacing="10.0" style="-fx-padding: 15;">
            <HBox alignment="CENTER_LEFT">
                <Label text="课程查询" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Pane HBox.hgrow="ALWAYS" />
            </HBox>
            <Separator />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="cardFlowPane" hgap="15" vgap="15"
                      style="-fx-padding: 15;" prefWrapLength="780" />
        </ScrollPane>
    </center>
</BorderPane>