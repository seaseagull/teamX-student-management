<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootStackPane"
           fx:controller="com.teach.javafx.controller.TravelController"
           style="-fx-background-color: linear-gradient(to bottom right, #f0faff, #d6f0fc, #b1e4f7);-fx-padding:35;">

    <VBox spacing="22" alignment="CENTER"
          style="-fx-background-color: rgba(255,255,255,0.94);-fx-background-radius:24;-fx-padding:50 60;-fx-effect: dropshadow(gaussian, rgba(15,60,90,0.12),22,0,0,6);-fx-min-width:560px;">

        <Label text="山东大学软件园校区-智能出行建议系统"
               style="-fx-font-size:28px;-fx-font-weight:bold;-fx-text-fill:#1a364b;-fx-padding:0 0 12 0;-fx-font-family:Microsoft YaHei;"/>

        <!--1 驾车【原有动态绑定，保留fx:id】-->
        <Label fx:id="driveLabel" text="🚗 驾车出行：降雨天气，路面湿滑谨慎驾车"
               style="-fx-font-size:18px;-fx-text-fill:#2c3e50;-fx-max-width:480px;-fx-line-spacing:6px;-fx-padding:6px 0;-fx-wrap-text:true;"/>
        <!--2 运动【原有动态绑定，保留fx:id】-->
        <Label fx:id="tourLabel" text="🏃 运动建议：有降雨，建议室内锻炼"
               style="-fx-font-size:18px;-fx-text-fill:#2c3e50;-fx-max-width:480px;-fx-line-spacing:6px;-fx-padding:6px 0;-fx-wrap-text:true;"/>
        <!--3 穿衣【原有动态绑定，保留fx:id】-->
        <Label fx:id="trafficLabel" text="👕 穿衣建议：平均气温25℃，推荐薄长袖+外套 | 雨天减速慢行"
               style="-fx-font-size:18px;-fx-text-fill:#2c3e50;-fx-max-width:480px;-fx-line-spacing:6px;-fx-padding:6px 0;-fx-wrap-text:true;"/>

        <!--新增1：校区通勤班车（静态文字，无后端绑定）-->
        <Label text="🚌 校区通勤班车：工作日早7:20、晚18:10往返校本部，雨天班车延迟10分钟发车，南门候车点避雨候车"
               style="-fx-font-size:18px;-fx-text-fill:#2c3e50;-fx-max-width:480px;-fx-line-spacing:6px;-fx-padding:6px 0;-fx-wrap-text:true;"/>
        <!--新增2：随身物品提醒（静态文字，无后端绑定）-->
        <Label text="🎒 随身物品提醒：降雨天气建议随身携带折叠雨伞、防水布袋，电子产品做好防潮，短途出行可备简易一次性雨披"
               style="-fx-font-size:18px;-fx-text-fill:#2c3e50;-fx-max-width:480px;-fx-line-spacing:6px;-fx-padding:6px 0;-fx-wrap-text:true;"/>

    </VBox>
</StackPane>