<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.StudentVolunteerController"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <VBox spacing="15.0" style="-fx-padding: 20;">
            <Label text="我的志愿" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <!-- 统计卡片 -->
            <HBox spacing="20.0">
                <VBox spacing="5.0" prefWidth="220"
                      style="-fx-background-color: #1677FF; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label fx:id="totalHoursLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="总志愿时长(小时)"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);" />
                </VBox>
                <VBox spacing="5.0" prefWidth="220"
                      style="-fx-background-color: #08BD91; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label fx:id="activityCountLabel" text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="参与活动数"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);" />
                </VBox>
            </HBox>
            <Separator />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="studentActivityListBox" spacing="12.0" style="-fx-padding: 0 20 20 20;" />
        </ScrollPane>
    </center>
</BorderPane>